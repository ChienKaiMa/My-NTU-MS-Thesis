@article{Barnett:09,
   author = {Stephen M. Barnett and Sarah Croke},
   journal = {Adv. Opt. Photon.},
   keywords = {Circular polarization; Polarization maintaining fibers; Quantum communications; Quantum cryptography; Quantum information; Quantum technology},
