\usetikzlibrary{decorations.pathreplacing}

\begin{tikzpicture}
    % Draw the number line
    \draw[thick, ->] (0, 0) -- (7, 0);
    % Mark the left endpoint (param = 0)
    \draw[fill=black] (0, 0) circle (0.1);
    \draw[fill=black] (3.3, 0) circle (0.1);
    \draw[fill=black] (5.5, 0) circle (0.1);
    \node[below] at (0, -0.2) {0};
    \node[below] at (3.3, -0.2) {$a (\simeq$2)};
    \node[below] at (5.5, -0.2) {$b (\simeq$3.3)};
    % Downward arrow and Special Solution label
    \node[above] at (1.65, 0.45) {$\simeq$OptUQSD}; % Label above point
    \node[above] at (4.4, 0.5) {Trade-offs}; % Label for solution set
    \node[above] at (6.15, 0.5) {$\simeq$MED}; % Label above point
    % Mark the specific range on the right (e.g., param > 3)
    \draw[thick, decorate, decoration={brace, amplitude=5pt}] (0.2, 0.3) -- (3.1, 0.3); % Brace for range
    \draw[thick, decorate, decoration={brace, amplitude=5pt}] (3.5, 0.3) -- (5.3, 0.3); % Brace for range
    \draw[thick, decorate, decoration={brace, amplitude=5pt}] (5.7, 0.3) -- (6.8, 0.3); % Brace for range
    % Parameter name
    \node[below] at (7.2, 0) {$1/w$}; % Parameter label under arrowhead
\end{tikzpicture}